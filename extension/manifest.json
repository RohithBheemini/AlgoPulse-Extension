{
  "manifest_version": 3,
  "name": "AlgoPulse - AI Code Reviewer & Tracker",
  "version": "1.1.0",
  "description": "AI-powered algorithmic analysis, complexity scoring, and automatic dashboard sync for LeetCode, GeeksforGeeks, and HackerRank.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://*.leetcode.com/*",
    "https://*.geeksforgeeks.org/*",
    "https://*.hackerrank.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AlgoPulse Settings & History",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.hackerrank.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.hackerrank.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "styles.css"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.hackerrank.com/*"
      ]
    }
  ]
}
